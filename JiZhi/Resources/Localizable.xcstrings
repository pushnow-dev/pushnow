    "Messages you open are marked as read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages you open are marked as read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开查看的通知会自动标为已读。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いた通知は自動的に既読になります。"
