    "Sandbox is a test server. It does not change your Apple purchase environment. Always check the App Store purchase confirmation.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandbox ist ein Testserver. Die Apple-Kaufumgebung wird dadurch nicht geändert. Prüfe stets die Kaufbestätigung im App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandbox is a test server. It does not change your Apple purchase environment. Always check the App Store purchase confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sandbox es un servidor de prueba. No cambia el entorno de compras de Apple. Revisa siempre la confirmación de App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンドボックスはテスト用サーバーです。Apple の購入環境は変わりません。App Store の購入確認を必ず確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샌드박스는 테스트 서버이며 Apple 구매 환경을 변경하지 않습니다. App Store 구매 확인 내용을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沙盒是测试服务器，不会改变 Apple 购买环境。请始终核对 App Store 购买确认信息。"
          }
        }
      }
    },
