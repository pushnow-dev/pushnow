    "This device will stop receiving messages. Revoking your last trusted device prevents approval of new devices.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät empfängt keine Nachrichten mehr. Ohne ein vertrauenswürdiges Gerät können keine neuen Geräte genehmigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device will stop receiving messages. Revoking your last trusted device prevents approval of new devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo dejará de recibir mensajes. Revocar el último dispositivo de confianza impide aprobar nuevos dispositivos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは受信を停止します。最後の信頼済みデバイスを失効すると新しいデバイスを承認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 메시지 수신을 중지합니다. 마지막 신뢰 기기를 해지하면 새 기기를 승인할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备将停止接收消息。撤销最后一台可信设备后，将无法批准新设备。"
          }
        }
      }
    },
