    "Subscriptions renew automatically unless cancelled in App Store settings. Payment is charged to your Apple Account after confirmation.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnements verlängern sich automatisch, sofern sie nicht in den App Store-Einstellungen gekündigt werden. Nach der Bestätigung wird dein Apple Account belastet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions renew automatically unless cancelled in App Store settings. Payment is charged to your Apple Account after confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las suscripciones se renuevan automáticamente salvo que se cancelen en los ajustes del App Store. El pago se carga a tu cuenta de Apple tras la confirmación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeの設定でキャンセルしない限り、サブスクリプションは自動更新されます。購入確認後、Apple Accountに請求されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 설정에서 취소하지 않으면 구독이 자동 갱신됩니다. 구매 확인 후 Apple 계정으로 요금이 청구됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非在 App Store 设置中取消，否则订阅将自动续订。确认购买后，费用将从你的 Apple 账户扣除。"
          }
        }
      }
    },
