  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260911.0-alpha",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.36.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  }
}
